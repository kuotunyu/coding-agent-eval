{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuotunyu.github.io/coding-agent-eval/schemas/agent-stdio-message.schema.json",
  "title": "Coding agent evaluation external-agent stdio message",
  "type": "object",
  "properties": {
    "protocol": {"const": "cae-agent-stdio"},
    "version": {"const": "1.0.0"},
    "id": {"type": "integer", "minimum": 0},
    "type": {"type": "string"},
    "payload": {"type": "object"}
  },
  "required": ["protocol", "version", "id", "type", "payload"],
  "$defs": {
    "envelope": {
      "type": "object",
      "properties": {
        "protocol": {"const": "cae-agent-stdio"},
        "version": {"const": "1.0.0"},
        "id": {"type": "integer", "minimum": 0},
        "type": {"type": "string"},
        "payload": {"type": "object"}
      },
      "required": ["protocol", "version", "id", "type", "payload"],
      "additionalProperties": false
    },
    "agent_identity": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      },
      "required": ["name", "version", "model"],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost_usd": {"type": "number", "minimum": 0},
        "completeness": {"enum": ["complete", "partial"]}
      },
      "additionalProperties": false
    },
    "initialize": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {
          "properties": {
            "type": {"const": "initialize"},
            "payload": {"type": "object"}
          }
        }
      ]
    },
    "initialized": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {
          "properties": {
            "type": {"const": "initialized"},
            "payload": {
              "type": "object",
              "properties": {"agent": {"$ref": "#/$defs/agent_identity"}},
              "required": ["agent"],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "next_step": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {
          "properties": {
            "type": {"const": "next-step"},
            "payload": {"type": "object"}
          }
        }
      ]
    },
    "tool_call_payload": {
      "type": "object",
      "properties": {
        "kind": {"const": "tool_call"},
        "tool_name": {"type": "string", "minLength": 1},
        "arguments": {"type": "object"},
        "usage": {"$ref": "#/$defs/usage"}
      },
      "required": ["kind", "tool_name", "arguments"],
      "additionalProperties": false
    },
    "stop_payload": {
      "type": "object",
      "properties": {
        "kind": {"const": "stop"},
        "reason": {"enum": ["completed", "partial", "no_output"]},
        "usage": {"$ref": "#/$defs/usage"}
      },
      "required": ["kind", "reason"],
      "additionalProperties": false
    },
    "step": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {
          "properties": {
            "type": {"const": "step"},
            "payload": {
              "oneOf": [
                {"$ref": "#/$defs/tool_call_payload"},
                {"$ref": "#/$defs/stop_payload"}
              ]
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/initialize"},
    {"$ref": "#/$defs/initialized"},
    {"$ref": "#/$defs/next_step"},
    {"$ref": "#/$defs/step"}
  ],
  "additionalProperties": false
}
