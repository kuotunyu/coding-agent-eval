{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuotunyu.github.io/coding-agent-eval/schemas/ledger-entry.schema.json",
  "title": "Adjudication ledger entry",
  "description": "One blinded human ruling, keyed so a changed fixture or changed finding cannot inherit it. SYNTHETIC- prefixed adjudicator ids are schema-valid but rejected by the formal ledger loader. Spec sections 6.6 and 8.3.1.",
  "type": "object",
  "properties": {
    "key": {
      "type": "object",
      "properties": {
        "fixture_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "bug_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/B-[0-9]{3}$"
        },
        "finding_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "fixture_version",
        "bug_id",
        "finding_hash"
      ],
      "additionalProperties": false
    },
    "decision": {
      "enum": [
        "same_root_cause",
        "different_root_cause",
        "insufficient"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "\\S"
    },
    "adjudication_protocol_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "adjudicator_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "decided_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "entry_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "key",
    "decision",
    "rationale",
    "adjudication_protocol_version",
    "adjudicator_id",
    "decided_at",
    "entry_hash"
  ],
  "additionalProperties": false
}
