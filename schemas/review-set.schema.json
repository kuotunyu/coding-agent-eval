{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuotunyu.github.io/coding-agent-eval/schemas/review-set.schema.json",
  "title": "Dual-review evidence manifest",
  "description": "Binds two independent blinded reviews and optional disagreement resolutions to one immutable run and candidate set.",
  "type": "object",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "public_identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "reviewer_role": {
      "type": "object",
      "properties": {
        "reviewer_id": {
          "$ref": "#/$defs/public_identity"
        },
        "independent_of_fixture_authors": {
          "type": "boolean"
        },
        "independent_of_run_operator": {
          "type": "boolean"
        },
        "independent_of_other_reviewers": {
          "type": "boolean"
        }
      },
      "required": [
        "reviewer_id",
        "independent_of_fixture_authors",
        "independent_of_run_operator",
        "independent_of_other_reviewers"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "review_set_id": {
      "type": "string",
      "pattern": "^rs-[a-z0-9][a-z0-9-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^fx-[a-z0-9][a-z0-9-]*$"
    },
    "fixture_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tree_checksum": {
      "$ref": "#/$defs/sha256"
    },
    "trace_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "findings_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "bugs_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "fixture_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_materials_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "trace_schema_version": {
      "const": "0.2.0"
    },
    "environment_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "fixture_author_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/public_identity"
      }
    },
    "run_operator_id": {
      "$ref": "#/$defs/public_identity"
    },
    "primary": {
      "$ref": "#/$defs/reviewer_role"
    },
    "independent": {
      "$ref": "#/$defs/reviewer_role"
    },
    "resolver": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/reviewer_role"
        }
      ]
    },
    "ledgers": {
      "type": "object",
      "properties": {
        "primary": {
          "const": "primary.jsonl"
        },
        "independent": {
          "const": "independent.jsonl"
        },
        "resolutions": {
          "const": "resolutions.jsonl"
        }
      },
      "required": [
        "primary",
        "independent",
        "resolutions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "review_set_id",
    "run_id",
    "fixture_id",
    "fixture_version",
    "tree_checksum",
    "trace_sha256",
    "findings_sha256",
    "bugs_sha256",
    "fixture_manifest_sha256",
    "candidate_set_sha256",
    "candidate_materials_sha256",
    "trace_schema_version",
    "environment_fingerprint",
    "fixture_author_ids",
    "run_operator_id",
    "primary",
    "independent",
    "resolver",
    "ledgers"
  ],
  "additionalProperties": false
}
